<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Entitlements for building with a FREE Apple ID (Personal Team).
	  Personal teams cannot provision `aps-environment` (Push Notifications),
	  so the VoIP-push entitlement must be dropped here.
	  Consequences: SIP register / calls / SMS all work, but the app cannot be
	  woken by a VoIP push after being killed. See docs/IOS-BUILD-ON-VENTURA.md.

	  For a paid team, build with CellBridgeApp.entitlements instead.
	-->
</dict>
</plist>
